{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API para controle financeiro com Fastify + Clean Architecture",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "prisma:prepare-provider": "node scripts/set-prisma-provider.mjs",
    "prisma:generate": "npm run prisma:prepare-provider && prisma generate",
    "prisma:migrate": "npm run prisma:prepare-provider && prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "fastify",
    "clean-architecture",
    "finance"
  ],
  "author": "Julio",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/sensible": "^6.0.4",
    "@google/genai": "^1.46.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.20",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.4",
    "openai": "^6.33.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.1.0",
    "prisma": "^6.16.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.4"
  }
}
